          "503": {
            "description": "Authentication or delivery unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "rahrowSession": []
          }
        ],
        "tags": [
          "Authentication"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "parameters": [
          {
            "name": "X-Rahrow-Auth",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "description": "Exact configured browser origin.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmptyAuthDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Current login family revoked; absent/unknown bearer is idempotent. Cookie cleared only after success."
          },
          "400": {
            "description": "Invalid or oversized request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          },
          "403": {
            "description": "Origin, JSON or custom-header safeguard rejected.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          },
          "429": {
            "description": "Authentication rate limit; Retry-After is supplied.",
            "content": {
              "application/json": {
                "schema": {
