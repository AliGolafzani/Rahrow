    "/api/v1/auth/session/rotate": {
      "post": {
        "operationId": "AuthController_rotateSession",
        "parameters": [
          {
            "name": "X-Rahrow-Auth",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "description": "Exact configured browser origin.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmptyAuthDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Committed rotation; absolute expiry preserved. Failure never clears a cookie.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RotatedSessionDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or oversized request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          },
          "403": {
            "description": "Origin, JSON or custom-header safeguard rejected.",
            "content": {
              "application/json": {
