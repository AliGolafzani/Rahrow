        ]
      }
    }
  },
  "info": {
    "title": "Rahrow AUTH-02 API",
    "description": "Bounded mobile OTP authentication. No real SMS or admin authentication. Strict DTOs, private/no-store responses and cookie-only persisted sessions. Explicit loopback local mode uses rahrow_local_session without Secure; normal cookie is __Host-rahrow_session.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "rahrowSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-rahrow_session"
      }
    },
    "schemas": {
      "AuthErrorDetailDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "AUTH_INVALID_INPUT",
              "AUTH_REQUEST_FORBIDDEN",
              "AUTH_THROTTLED",
              "AUTH_OTP_INVALID",
              "AUTH_OTP_EXPIRED",
              "AUTH_OTP_EXHAUSTED",
              "AUTH_OTP_CONSUMED",
              "AUTH_SESSION_INVALID",
              "AUTH_SESSION_EXPIRED",
              "AUTH_DELIVERY_UNAVAILABLE",
              "AUTH_UNAVAILABLE"
            ]
          },
          "message": {
            "type": "string"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "retryAfterSeconds": {
            "type": "number",
            "minimum": 1,
            "maximum": 86400
          }
        },
        "required": [
          "code",
          "message",
          "correlationId"
        ],
        "additionalProperties": false
      },
      "AuthErrorDto": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/AuthErrorDetailDto"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "RequestOtpDto": {
        "type": "object",
        "properties": {
          "mobile": {
            "type": "string",
            "minLength": 2,
            "maxLength": 16,
            "pattern": "^\\+[1-9][0-9]{0,14}$"
          }
        },
        "required": [
          "mobile"
        ],
        "additionalProperties": false
      },
      "RequestedOtpDto": {
        "type": "object",
        "properties": {
          "challengeId": {
            "type": "string",
            "format": "uuid"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "retryAfterSeconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 86400
          }
        },
        "required": [
          "challengeId",
          "expiresAt",
          "retryAfterSeconds"
        ],
        "additionalProperties": false
      },
      "VerifyOtpDto": {
        "type": "object",
        "properties": {
          "mobile": {
            "type": "string",
            "minLength": 2,
            "maxLength": 16,
            "pattern": "^\\+[1-9][0-9]{0,14}$"
          },
          "challengeId": {
            "type": "string",
            "format": "uuid",
            "minLength": 36,
            "maxLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "code": {
            "type": "string",
            "minLength": 6,
            "maxLength": 6,
            "pattern": "^[0-9]{6}$"
          }
        },
        "required": [
          "mobile",
          "challengeId",
          "code"
        ],
        "additionalProperties": false
      },
      "AuthenticatedSelfDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "mobile": {
            "type": "string",
            "pattern": "^\\+[1-9][0-9]{0,14}$"
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "firstName": {
            "type": "string",
            "nullable": true
          },
          "lastName": {
            "type": "string",
            "nullable": true
          },
          "birthDate": {
            "type": "string",
            "nullable": true,
            "format": "date"
          },
          "displayName": {
            "type": "string",
            "nullable": true
          },
          "avatar": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "mobile",
          "email",
          "firstName",
          "lastName",
          "birthDate",
          "displayName",
          "avatar"
        ],
        "additionalProperties": false
      },
      "SessionExpiryDto": {
        "type": "object",
        "properties": {
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "expiresAt"
        ],
        "additionalProperties": false
      },
      "AuthenticatedSessionDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/AuthenticatedSelfDto"
          },
          "session": {
            "$ref": "#/components/schemas/SessionExpiryDto"
          }
        },
        "required": [
          "user",
          "session"
        ],
        "additionalProperties": false
      },
      "EmptyAuthDto": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "RotatedSessionDto": {
        "type": "object",
        "properties": {
          "session": {
            "$ref": "#/components/schemas/SessionExpiryDto"
          }
        },
        "required": [
          "session"
        ],
        "additionalProperties": false
      }
    }
  }
}
