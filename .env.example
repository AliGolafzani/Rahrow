# Local development examples only. Never reuse these values outside this setup.
# Copy this file to .env at the repository root; .env is ignored by Git.
POSTGRES_USER=rahrow_local
POSTGRES_PASSWORD=rahrow_local_dev_only
POSTGRES_DB=rahrow_local
POSTGRES_PORT=5432
# Keep user, password, port, and database in sync with the values above.
DATABASE_URL=postgresql://rahrow_local:rahrow_local_dev_only@127.0.0.1:5432/rahrow_local?schema=public

# Optional AUTH-02 local-only runtime settings. Supply externally to the API process.
# The default is unconfigured (auth 503); Fake is NEVER a production fallback.
# HOST=127.0.0.1
# NODE_ENV=development
# AUTH_MODE=local
# AUTH_ALLOWED_ORIGINS=http://127.0.0.1:3000
# AUTH_COOKIE_MODE=local
# AUTH_OTP_LIFETIME_MS=300000
# AUTH_OTP_ATTEMPT_LIMIT=5
# AUTH_OTP_COOLDOWN_MS=60000
# AUTH_OTP_MAX_ACTIVE_CHALLENGES=5
# AUTH_SESSION_LIFETIME_MS=43200000
# AUTH_DELIVERY_TIMEOUT_MS=2000
# No key or SMS credentials: local activation generates a private ephemeral key.
