# Local development examples only. Never reuse these values outside this setup.
# Copy this file to .env at the repository root; .env is ignored by Git.
POSTGRES_USER=rahrow_local
POSTGRES_PASSWORD=rahrow_local_dev_only
POSTGRES_DB=rahrow_local
POSTGRES_PORT=5432
# Keep user, password, port, and database in sync with the values above.
DATABASE_URL=postgresql://rahrow_local:rahrow_local_dev_only@127.0.0.1:5432/rahrow_local?schema=public
